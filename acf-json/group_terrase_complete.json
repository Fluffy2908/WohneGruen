{
    "key": "group_terrase_complete",
    "title": "Terrasse Komplett Block",
    "fields": [
        {
            "key": "field_terrase_type",
            "label": "Terrassen Typ",
            "name": "terrase_type",
            "type": "radio",
            "instructions": "Wählen Sie den Typ der Terrasse",
            "required": 1,
            "choices": {
                "nature": "Nature (Farbe → Ausrichtung → Galerie)",
                "pure": "Pure (Farbe → Größe → Ausrichtung → Galerie)"
            },
            "default_value": "nature",
            "layout": "vertical"
        },
        {
            "key": "field_terrase_hero_title",
            "label": "Hero Titel",
            "name": "terrase_hero_title",
            "type": "text",
            "instructions": "Haupttitel (leer lassen für Post-Titel)",
            "required": 0,
            "placeholder": ""
        },
        {
            "key": "field_terrase_hero_subtitle",
            "label": "Hero Untertitel",
            "name": "terrase_hero_subtitle",
            "type": "textarea",
            "instructions": "Kurze Beschreibung unter dem Titel",
            "required": 0,
            "rows": 3
        },
        {
            "key": "field_terrase_hero_image",
            "label": "Hero Hintergrundbild",
            "name": "terrase_hero_image",
            "type": "image",
            "instructions": "Hintergrundbild für Hero-Bereich",
            "return_format": "array",
            "preview_size": "medium"
        },
        {
            "key": "field_terrase_description_title",
            "label": "Beschreibung Titel",
            "name": "terrase_description_title",
            "type": "text",
            "instructions": "Titel für den Beschreibungsbereich",
            "default_value": ""
        },
        {
            "key": "field_terrase_description_text",
            "label": "Beschreibung Text",
            "name": "terrase_description_text",
            "type": "wysiwyg",
            "instructions": "Detaillierte Beschreibung der Terrasse",
            "required": 1,
            "tabs": "all",
            "toolbar": "full",
            "media_upload": 1
        },
        {
            "key": "field_terrase_tech_specs",
            "label": "Technische Daten",
            "name": "terrase_tech_specs",
            "type": "repeater",
            "instructions": "Technische Spezifikationen (wird links angezeigt)",
            "min": 0,
            "layout": "table",
            "button_label": "Daten hinzufügen",
            "sub_fields": [
                {
                    "key": "field_terrase_spec_label",
                    "label": "Bezeichnung",
                    "name": "label",
                    "type": "text",
                    "required": 1,
                    "placeholder": "z.B. Material"
                },
                {
                    "key": "field_terrase_spec_value",
                    "label": "Wert",
                    "name": "value",
                    "type": "text",
                    "required": 1,
                    "placeholder": "z.B. WPC"
                }
            ]
        },
        {
            "key": "field_terrase_tech_description",
            "label": "Technische Beschreibung",
            "name": "terrase_tech_description",
            "type": "wysiwyg",
            "instructions": "Beschreibung für rechte Spalte (neben technischen Daten)",
            "tabs": "all",
            "toolbar": "basic",
            "media_upload": 0
        },
        {
            "key": "field_terrase_color_variants",
            "label": "Farbvarianten",
            "name": "terrase_color_variants",
            "type": "repeater",
            "instructions": "Farboptionen (Anthrazit, Weiß, etc.)",
            "required": 1,
            "min": 1,
            "max": 4,
            "layout": "block",
            "button_label": "Farbe hinzufügen",
            "sub_fields": [
                {
                    "key": "field_terrase_color_name",
                    "label": "Farbname",
                    "name": "color_name",
                    "type": "text",
                    "required": 1,
                    "placeholder": "z.B. Anthrazit, Weiß"
                },
                {
                    "key": "field_terrase_color_code",
                    "label": "Farbcode",
                    "name": "color_code",
                    "type": "color_picker",
                    "required": 1,
                    "default_value": "#ffffff"
                },
                {
                    "key": "field_terrase_nature_orientations",
                    "label": "Ausrichtungen (für Nature)",
                    "name": "nature_orientations",
                    "type": "repeater",
                    "instructions": "Ausrichtungen: Vertikal, Horizontal, Gemischt",
                    "conditional_logic": [
                        [
                            {
                                "field": "field_terrase_type",
                                "operator": "==",
                                "value": "nature"
                            }
                        ]
                    ],
                    "min": 1,
                    "max": 3,
                    "layout": "block",
                    "button_label": "Ausrichtung hinzufügen",
                    "sub_fields": [
                        {
                            "key": "field_terrase_orientation_name",
                            "label": "Ausrichtung",
                            "name": "orientation_name",
                            "type": "text",
                            "required": 1,
                            "placeholder": "z.B. Vertikal, Horizontal, Gemischt"
                        },
                        {
                            "key": "field_terrase_orientation_gallery",
                            "label": "Galerie",
                            "name": "gallery",
                            "type": "gallery",
                            "instructions": "4-8 Bilder für diese Ausrichtung",
                            "required": 1,
                            "min": 4,
                            "max": 8,
                            "insert": "append",
                            "preview_size": "thumbnail",
                            "return_format": "array"
                        }
                    ]
                },
                {
                    "key": "field_terrase_pure_sizes",
                    "label": "Größenvarianten (für Pure)",
                    "name": "pure_sizes",
                    "type": "repeater",
                    "instructions": "Pure, Pure-Groß, Pure-Extra-Groß",
                    "conditional_logic": [
                        [
                            {
                                "field": "field_terrase_type",
                                "operator": "==",
                                "value": "pure"
                            }
                        ]
                    ],
                    "min": 1,
                    "max": 3,
                    "layout": "block",
                    "button_label": "Größe hinzufügen",
                    "sub_fields": [
                        {
                            "key": "field_terrase_size_name",
                            "label": "Größenname",
                            "name": "size_name",
                            "type": "text",
                            "required": 1,
                            "placeholder": "z.B. Pure, Pure-Groß, Pure-Extra-Groß"
                        },
                        {
                            "key": "field_terrase_size_orientations",
                            "label": "Ausrichtungen",
                            "name": "orientations",
                            "type": "repeater",
                            "instructions": "Vertikal, Horizontal, Gemischt",
                            "min": 1,
                            "max": 3,
                            "layout": "block",
                            "button_label": "Ausrichtung hinzufügen",
                            "sub_fields": [
                                {
                                    "key": "field_terrase_pure_orientation_name",
                                    "label": "Ausrichtung",
                                    "name": "orientation_name",
                                    "type": "text",
                                    "required": 1,
                                    "placeholder": "z.B. Vertikal, Horizontal, Gemischt"
                                },
                                {
                                    "key": "field_terrase_pure_orientation_gallery",
                                    "label": "Galerie",
                                    "name": "gallery",
                                    "type": "gallery",
                                    "instructions": "4-8 Bilder für diese Ausrichtung",
                                    "required": 1,
                                    "min": 4,
                                    "max": 8,
                                    "insert": "append",
                                    "preview_size": "thumbnail",
                                    "return_format": "array"
                                }
                            ]
                        }
                    ]
                }
            ]
        }
    ],
    "location": [
        [
            {
                "param": "block",
                "operator": "==",
                "value": "acf/wohnegruen-terrase-complete"
            }
        ]
    ],
    "menu_order": 0,
    "position": "normal",
    "style": "default",
    "label_placement": "top",
    "instruction_placement": "label",
    "hide_on_screen": "",
    "active": true,
    "description": "Block für Terrassen-Seiten - KEINE HARDCODED INHALTE"
}
